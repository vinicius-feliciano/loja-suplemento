# ===================================================================
# Nova Era Nutrition — Arquivo de Exemplo de Variáveis de Ambiente
# COPIE este arquivo para '.env' e preencha com suas credenciais reais.
# NUNCA comite o arquivo '.env' real no GitHub ou repositório público!
# ===================================================================

# Porta do Servidor Node.js
PORT=3000

# URL Base da Aplicação (usada em retornos de pagamento e webhooks)
BASE_URL=http://localhost:3000

# -------------------------------------------------------------------
# Banco de Dados MongoDB Atlas
# -------------------------------------------------------------------
# Obtenha a connection string no MongoDB Atlas (Database -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<usuario>:<senha>@cluster0.exemplo.mongodb.net/novaera?retryWrites=true&w=majority

# -------------------------------------------------------------------
# Credenciais do Administrador (Painel /admin.html)
# -------------------------------------------------------------------
ADMIN_TOKEN=defina_um_token_admin_longo_e_aleatorio_aqui
ADMIN_EMAIL=admin@novaera.com
ADMIN_PASS=defina_uma_senha_forte_aqui

# -------------------------------------------------------------------
# Autenticação de Clientes & Segurança (JWT & Google Sign-In)
# -------------------------------------------------------------------
JWT_SECRET=defina_um_segredo_jwt_aleatorio_e_seguro_aqui
# Opcional: Google Client ID para login com Google One-Tap
GOOGLE_CLIENT_ID=

# -------------------------------------------------------------------
# Meios de Pagamento (Mercado Pago)
# Obtenha em: https://www.mercadopago.com.br/developers/panel
# -------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADOPAGO_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000

# -------------------------------------------------------------------
# Chave PIX Direta (Contingência / Pagamento Manual)
# -------------------------------------------------------------------
PIX_CHAVE=sua_chave_pix_aqui
PIX_BENEFICIARIO=Nova Era Nutrition
PIX_CIDADE=Sua Cidade
